<h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-6">Settings</h1>

<section class="card p-5 mb-4">
  <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">Account</h2>
  <dl class="flex flex-col gap-1">
    <dt class="text-xs text-gray-500 dark:text-gray-400">Phone number</dt>
    <dd class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= current_user.phone %></dd>
  </dl>
</section>

<section class="card p-5 mb-4">
  <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">Notifications</h2>
  <label class="flex items-center justify-between gap-4 cursor-pointer">
    <span class="text-sm text-gray-700 dark:text-gray-300">
      Send me SMS messages when my bands announce shows near me
    </span>
    <span class="relative inline-flex shrink-0"
          data-controller="notification-toggle"
          data-notification-toggle-url-value="<%= settings_notifications_path %>">
      <input type="checkbox"
             <%= "checked" if current_user.sms_alerts_enabled? %>
             data-action="change->notification-toggle#toggle"
             class="peer sr-only">
      <span class="w-11 h-6 bg-gray-200 dark:bg-gray-700 rounded-full peer-checked:bg-green-600 transition-colors"></span>
      <span class="absolute left-0.5 top-0.5 size-5 bg-white rounded-full shadow transition-transform peer-checked:translate-x-5"></span>
    </span>
  </label>
</section>

<section class="card p-5 mb-4">
  <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">Password</h2>
  <%= form_with url: settings_password_path, method: :patch, class: "flex flex-col gap-3" do |f| %>
    <% if current_user.has_password? %>
      <%= f.label :current_password, "Current password", class: "font-medium text-sm text-gray-700 dark:text-gray-300" %>
      <%= f.password_field :current_password, required: true, class: "input-field" %>
    <% else %>
      <p class="text-sm text-gray-600 dark:text-gray-300">
        Set a password so you can log in without waiting for a text — handy when
        you don't have signal (e.g. on a plane).
      </p>
    <% end %>
    <%= f.label :new_password, current_user.has_password? ? "New password" : "Password", class: "font-medium text-sm text-gray-700 dark:text-gray-300" %>
    <%= f.password_field :new_password, required: true, class: "input-field" %>
    <%= f.label :new_password_confirmation, "Confirm password", class: "font-medium text-sm text-gray-700 dark:text-gray-300" %>
    <%= f.password_field :new_password_confirmation, required: true, class: "input-field" %>
    <%= f.submit current_user.has_password? ? "Update password" : "Set password", class: "btn-primary py-2" %>
  <% end %>
</section>

<section class="card p-5 mb-6">
  <%= button_to "Log out", logout_path, method: :delete, class: "btn-primary py-2 w-full" %>
</section>
