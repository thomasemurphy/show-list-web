<h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-6">Enter your code</h1>
<p class="mb-4 text-gray-600 dark:text-gray-400">We texted a 6-digit code to <%= session[:pending_phone] %>.</p>

<%= form_with url: login_verify_path, method: :post, class: "card p-5 flex flex-col gap-3" do |f| %>
  <%= f.label :code, "Code", class: "font-medium text-sm text-gray-700 dark:text-gray-300" %>
  <%= f.text_field :code, inputmode: "numeric", pattern: "[0-9]*", maxlength: 6, required: true,
        class: "input-field" %>
  <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
    <%= f.check_box :stay_logged_in, checked: true %>
    Stay logged in
  </label>
  <%= f.submit "Verify", class: "btn-primary py-2" %>
<% end %>
