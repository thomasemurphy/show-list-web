<!DOCTYPE html>
<html>
  <head>
    <%= javascript_tag nonce: true do %>
      (function () {
        var STORAGE_KEY = "theme";
        var stored = localStorage.getItem(STORAGE_KEY) || "system";
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var isDark = stored === "dark" || (stored === "system" && prefersDark);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    <% end %>

    <title><%= content_for(:title) || "showlist" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Show List Web">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Keep scroll position when a form submission re-renders the current
        page instead of redirecting (e.g. BandsController#create's ambiguous
        picker) — otherwise Turbo jumps to the top by default. %>
    <meta name="turbo-refresh-scroll" content="preserve">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gradient-to-b from-gray-50 to-gray-200 dark:from-gray-900 dark:to-gray-950 min-h-screen">
    <%# Guests get the nav too — the dashboard is their landing page — with a
        Log in button where the settings gear goes (not on the login pages
        themselves, where it would only link to where they already are). %>
    <nav class="border-b border-gray-200 dark:border-gray-800 bg-white/60 dark:bg-gray-900/60 backdrop-blur">
      <div class="container mx-auto px-5 <%= content_for(:main_class) || "max-w-md" %> flex items-center justify-between h-14">
        <%# Guests are already on the dashboard, or on a login page with its own Back button. %>
        <% if logged_in? %>
          <%= link_to "My Shows", dashboard_path, class: "text-sm font-semibold text-gray-900 dark:text-gray-100" %>
        <% end %>
        <div class="flex items-center gap-1 ml-auto">
          <button type="button" data-controller="theme" data-action="click->theme#cycle"
                  class="btn-text-muted inline-flex items-center justify-center p-1.5" aria-label="Toggle color theme">
            <%= render "shared/sun_icon", target: "lightIcon" %>
            <%= render "shared/moon_icon", target: "darkIcon", size: "size-4 hidden" %>
            <%= render "shared/monitor_icon", target: "systemIcon", size: "size-4 hidden" %>
          </button>
          <% if logged_in? %>
            <%= link_to settings_path, class: "btn-text-muted inline-flex items-center justify-center p-1.5", aria: { label: "Settings" } do %>
              <%= render "shared/gear_icon" %>
            <% end %>
          <% elsif controller_name != "sessions" %>
            <%= link_to "Log in", login_path, class: "btn-primary btn-soft ml-1" %>
          <% end %>
        </div>
      </div>
    </nav>
    <main class="container mx-auto <%= content_for(:main_margin) || "mt-16" %> px-5 <%= content_for(:main_class) || "max-w-md" %>">
      <%# page_flashes, not flash: the add-a-band outcome is rendered next to
          the Add band control instead of up here. %>
      <% page_flashes.each do |_type, message| %>
        <div data-controller="flash" class="mb-4 px-3 py-2 rounded-lg border flex items-center justify-between gap-2 <%= flash_classes %>">
          <p><%= message %></p>
          <button type="button" data-action="click->flash#dismiss" class="shrink-0 opacity-70 hover:opacity-100" aria-label="Dismiss">
            <%= render "shared/x_icon", size: "size-3.5" %>
          </button>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
