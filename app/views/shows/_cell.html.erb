<%= turbo_frame_tag "show_cell_#{ShowCache.key(band, zip)}", class: "block",
      data: {
        controller: "refresh-spinner",
        action: "turbo:frame-load->refresh-spinner#finish",
        # Unchecked cells (e.g. every band in a just-added zip column) are
        # picked up by the dashboard table's "checker" controller, which
        # loads them one at a time in DOM order rather than all at once.
        **(checked ? {} : { checker_target: "cell", checker_url: shows_path(band: band, zip: zip) }),
      } do %>
  <% if checked %>
    <div class="flex items-center justify-center gap-0.5">
      <% if local_assigns[:not_found] %>
        <div class="text-xs text-gray-400">Not found on SeatGeek</div>
      <% elsif events.present? %>
        <%= link_to shows_path(band: band, zip: zip), data: { turbo_frame: "_top" }, class: "text-sm font-semibold text-green-600 hover:text-green-700 hover:underline transition-colors dark:text-green-400 dark:hover:text-green-300" do %>
          <%= events.map { |event| (Date.parse(event["datetime_local"]).strftime("%b %-d") rescue event["datetime_local"]) }.join(", ") %>
        <% end %>
      <% end %>
      <%= link_to shows_path(band: band, zip: zip, refresh: true), class: "btn-text-muted inline-flex items-center justify-center p-0.5", title: "Refresh", aria: { label: "Refresh #{band} near #{zip}" }, data: { action: "click->refresh-spinner#start" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-2 refresh-icon">
          <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path>
        </svg>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-2 refresh-icon checking-icon text-gray-400" aria-hidden="true">
        <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path>
      </svg>
      <div class="text-xs text-gray-400">Not checked yet</div>
    </div>
  <% end %>
<% end %>
