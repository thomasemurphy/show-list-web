<%= link_to dashboard_path, class: "btn-text-muted inline-flex items-center justify-center p-2 mb-3", title: "Back to dashboard", aria: { label: "Back to dashboard" } do %>
  <%= render "shared/back_icon", size: "size-6" %>
<% end %>

<h1 class="text-2xl font-semibold mb-6 text-gray-900"><%= @band %> near <%= @zip %></h1>

<% if @not_found %>
  <p class="text-gray-500 mb-4">Couldn't find <%= @band %> on SeatGeek — check the spelling?</p>
<% elsif @events.empty? %>
  <p class="text-gray-500 mb-4">No upcoming shows found nearby.</p>
<% else %>
  <ul class="flex flex-col gap-2 mb-4">
    <% @events.each do |event| %>
      <li class="card px-4 py-3 text-center">
        <div class="font-medium text-gray-900 dark:text-gray-100"><%= event["title"] %></div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mb-1">
          <div><%= event_date(event["datetime_local"]) %></div>
          <div><%= event_time(event["datetime_local"]) %></div>
          <div><%= event["venue_name"] %></div>
          <div><%= event["venue_city"] %></div>
        </div>
        <%= link_to "🎫 GET TICKETS 🎫", event["url"], class: "btn-primary bg-gray-700 dark:bg-gray-100 mt-2 inline-block", target: "_blank", rel: "noopener" %>
      </li>
    <% end %>
  </ul>
<% end %>
